<Window x:Class="KnightsCleaner.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Knights Cleaner" Width="1080" Height="850" MinWidth="860" MinHeight="780"
 Background="#0B0F17" Foreground="#E8EDF5" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#223047"/><Setter Property="Foreground" Value="#FFFFFF"/>
   <Setter Property="Padding" Value="18,10"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E8EDF5"/><Setter Property="Margin" Value="8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="ServiceCard" TargetType="CheckBox">
   <Setter Property="Foreground" Value="#E8EDF5"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="Width" Value="318"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Border x:Name="Card" Background="#131C2A" BorderBrush="#263449" BorderThickness="1" CornerRadius="9" Padding="14">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border x:Name="Mark" Width="17" Height="17" CornerRadius="4" BorderBrush="#62748B" BorderThickness="1" VerticalAlignment="Top" Margin="0,3,0,0"><TextBlock x:Name="Tick" Text="✓" Visibility="Collapsed" Foreground="#071610" HorizontalAlignment="Center" FontWeight="Bold"/></Border>
      <ContentPresenter Grid.Column="1"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#42C8A4"/><Setter TargetName="Mark" Property="Background" Value="#42C8A4"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#1B293B"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Card" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20">
   <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><TextBlock Text="STARTUP CLEANER / 0.2" Foreground="#51D2AF" FontWeight="SemiBold"/><TextBlock x:Name="AccessStatus" Foreground="#93A5BE" HorizontalAlignment="Right" Margin="0,6,0,0"/></StackPanel>
   <StackPanel><TextBlock Text="KNIGHTS CLEANER" FontSize="28" FontWeight="Bold"/><TextBlock Text="Your cleanup script. One control panel." Foreground="#93A5BE" Margin="0,5,0,0"/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="#070B11" BorderBrush="#243044" BorderThickness="1" CornerRadius="10" Padding="18">
   <DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock DockPanel.Dock="Right" Text="LIVE OUTPUT" Foreground="#5C718D" FontSize="11"/><TextBlock Text="●  ACTIVITY CONSOLE" Foreground="#51D2AF" FontWeight="SemiBold"/></DockPanel>
    <ListBox x:Name="Activity" Background="Transparent" Foreground="#BFD0E3" BorderThickness="0" FontFamily="Consolas" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
   </DockPanel>
  </Border>
  <StackPanel Grid.Row="2" x:Name="DrivePanel" Margin="0,14,0,12">
   <DockPanel><Button DockPanel.Dock="Right" Content="Refresh drives" Click="Refresh_Click"/><TextBlock Text="TARGET DRIVES" Foreground="#93A5BE" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
   <ScrollViewer MaxHeight="60" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="Drives"/></ScrollViewer>
  </StackPanel>
  <StackPanel Grid.Row="3"><TextBlock Text="CLEANUP SERVICES" Foreground="#93A5BE" FontWeight="SemiBold" Margin="0,0,0,10"/><WrapPanel x:Name="Services"/></StackPanel>
  <DockPanel Grid.Row="4" Margin="0,10,0,0">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="AdminButton" Content="Administrator" Click="Admin_Click"/><Button x:Name="CancelButton" Content="Cancel" IsEnabled="False" Click="Cancel_Click"/><Button x:Name="RunButton" Content="RUN CLEANER" Background="#168365" Width="145" Click="Run_Click"/></StackPanel>
   <CheckBox x:Name="SelectAll" Content="Select All" IsThreeState="False" Click="SelectAll_Click"/>
   <TextBlock x:Name="Status" Text="Ready" Foreground="#93A5BE" VerticalAlignment="Center" Margin="12,0"/>
  </DockPanel>
 </Grid>
</Window>
