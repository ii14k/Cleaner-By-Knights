<Window x:Class="KnightsCleaner.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Knights Cleaner" Width="1000" Height="780" MinWidth="720" MinHeight="680"
 Background="#0C1018" Foreground="#E6EDF6" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#27384E"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Padding" Value="18,9"/><Setter Property="Margin" Value="6,0,0,0"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E6EDF6"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="8"/></Style>
 </Window.Resources>
 <Grid Margin="26">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20">
   <TextBlock DockPanel.Dock="Right" Text="v0.1 / TEMP CLEANER" Foreground="#8EABC9" VerticalAlignment="Center"/>
   <StackPanel><TextBlock Text="KNIGHTS CLEANER" FontSize="27" FontWeight="Bold"/><TextBlock Text="Choose your drives and services. Follow every step." Foreground="#94A3B8" Margin="0,6,0,0"/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="#080C12" BorderBrush="#243044" BorderThickness="1" CornerRadius="10" Padding="16">
   <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="ACTIVITY LOG" Foreground="#62D6B2" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <ListBox x:Name="Activity" Background="Transparent" Foreground="#BFD0E3" BorderThickness="0" FontFamily="Consolas" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
   </DockPanel>
  </Border>
  <StackPanel Grid.Row="2" x:Name="DrivePanel" Margin="0,16,0,10">
   <DockPanel><Button DockPanel.Dock="Right" Content="Refresh drives" Click="Refresh_Click"/><TextBlock Text="DRIVES" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
   <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="Drives"/></ScrollViewer>
   <TextBlock Text="Only known Temp folders on selected drives are cleaned. Other drives start unchecked." Foreground="#94A3B8" TextWrapping="Wrap"/>
  </StackPanel>
  <Grid Grid.Row="3" x:Name="Services" Margin="0,8,0,16">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="#151E2D" CornerRadius="8" Padding="12" Margin="0,0,8,0"><CheckBox x:Name="UserTemp" IsChecked="True" Checked="SelectionChanged" Unchecked="SelectionChanged"><StackPanel><TextBlock Text="User Temp" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Temporary files for your account" Foreground="#94A3B8" Margin="0,5,0,0"/></StackPanel></CheckBox></Border>
   <Border Grid.Column="1" Background="#151E2D" CornerRadius="8" Padding="12" Margin="8,0,0,0"><CheckBox x:Name="WindowsTemp" IsChecked="True" Checked="SelectionChanged" Unchecked="SelectionChanged"><StackPanel><TextBlock Text="Windows Temp" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Skips files requiring permission" Foreground="#94A3B8" Margin="0,5,0,0"/></StackPanel></CheckBox></Border>
  </Grid>
  <DockPanel Grid.Row="4">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="CancelButton" Content="Cancel" IsEnabled="False" Click="Cancel_Click"/><Button x:Name="RunButton" Content="RUN" Background="#187C65" Width="130" Click="Run_Click"/></StackPanel>
   <CheckBox x:Name="SelectAll" Content="Select All" IsChecked="True" IsThreeState="False" Click="SelectAll_Click"/>
   <TextBlock x:Name="Status" Text="Ready" Foreground="#94A3B8" VerticalAlignment="Center" Margin="16,0"/>
  </DockPanel>
 </Grid>
</Window>
